# Copy this file to .env next to deploy.sh, then edit the list.

# Folder names under APPS_ROOT, separated by spaces.
# An absolute path also works.
APPS="chess-review game-tracker"

# Parent folder of the app folders. Default: the home folder of the cron user.
#APPS_ROOT=/home/<user>

# Branch that every app follows.
BRANCH=main

# Command that runs Docker. Cron runs as a normal user, so sudo is needed.
DOCKER="sudo -n docker"

# Log file. Default: deploy.log next to deploy.sh.
#LOG_FILE=/home/<user>/nas-deploy/deploy.log
